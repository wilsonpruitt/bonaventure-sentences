.env*.local
.DS_Store
node_modules/

# Raw source material (large binary / OCR dumps — keep local, out of git)
raw/*.pdf
raw/*_raw.txt
raw/*_djvu.txt
raw/vision/
manual-review/*-numbered.txt

# Pre-rebuild snapshots — ephemeral insurance, prior versions live in git history.
# Matches both dirs (_backup-.../) and loose files (_backup-*.md, _backup-*.md.bak).
vol1/_backup-*
_backup-*

# Python caches
**/__pycache__/

# Next.js build artifacts
site/tsconfig.tsbuildinfo
